#======================================================#
#  .env.main.example                                   #
#  For: docker-compose.main.yml                        #
#  Purpose: Shared infrastructure (postgres + proxy)   #
#======================================================#

#--------------------------#
#    Project              #
#--------------------------#
PROJECT_NAME=o19_main
SERVICES=postgres,proxy,acme
SUPPORT_EMAIL=mail@example.com

#--------------------------#
#    Postgres             #
#--------------------------#
POSTGRES_TAG=17
PGVECTOR_VERSION=0.8.1
LOAD_LANGUAGE=es_PE
PGDATA=/var/lib/postgresql/data/${PROJECT_NAME}

# Superuser (used by postgres container)
POSTGRES_MAIN_USER=postgres
POSTGRES_MAIN_PASSWORD=odoo

# Default DB user (fallback, used by entrypoint.sh)
DB_USER=odoo
DB_PASSWORD=odoo
DB_TEMPLATE=unaccent_template
UNACCENT_TEMPLATE=true

# Multi-tenant users (created by postgres/entrypoint.sh)
# Add as many DB_USER_N/DB_PASSWORD_N pairs as needed
DB_USER_1=cliente_1
DB_PASSWORD_1=odoo123456
DB_USER_2=cliente_2
DB_PASSWORD_2=odoo123456
DB_USER_3=cliente_3
DB_PASSWORD_3=odoo123456
# DB_USER_4=cliente_4
# DB_PASSWORD_4=odoo123456
# DB_USER_5=cliente_5
# DB_PASSWORD_5=odoo123456

#--------------------------#
#    PgAdmin              #
#--------------------------#
USE_PGADMIN=false
PGADMING_DB_NAME=pgadmin
PGADMING_DB_USER=pgadmin
PGADMIN_DB_PASSWORD=${DB_PASSWORD}

#--------------------------#
#    Nginx Proxy          #
#--------------------------#
NGINX_PROXY_TAG=1.4.0
DOCKER_SOCK=/var/run/docker.sock
TEMP_DOCKER_SOCK=/tmp/docker.sock
TRUST_DOWNSTREAM_PROXY=true
CORS_ALLOWED_DOMAIN="'http://external-domain.test'"

#--------------------------#
#    ACME / SSL           #
#--------------------------#
ACME_COMPANION_TAG=2.2.9
# For prod use: https://acme-v02.api.letsencrypt.org/directory
ACME_CA_URI=https://acme-staging-v02.api.letsencrypt.org/directory
CERTS_UPDATE_INTERVAL=3600
DEFAULT_EMAIL=${SUPPORT_EMAIL}

#--------------------------#
#    Paths (Nginx Proxy)  #
#--------------------------#
NGINX_CONF=/etc/nginx/nginx.conf
NGINX_CERTS=/etc/nginx/certs
NGINX_VHOST=/etc/nginx/vhost.d
NGINX_HTML=/usr/share/nginx/html
NGINX_ACME=/etc/acme.sh
NGINX_PROXY_CORS_CONF=/etc/nginx/cors.conf

#------------------------------#
#    Project Configurations    #
#------------------------------#
COMPOSE_PROJECT_NAME=${PROJECT_NAME}
COMPOSE_PROFILES=${SERVICES}

# Service profiles
POSTGRES_PROFILES="postgres"
NGINX_PROXY_PROFILES="proxy"
ACME_COMPANION_PROFILES="acme"

#----------------#
#    Postgres    #
#----------------#
POSTGRES_HOST=${POSTGRES_MAIN_USER}
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=${POSTGRES_MAIN_USER}
POSTGRES_PASSWORD=${POSTGRES_MAIN_PASSWORD}
